{
  "name": "easy-pos",
  "productName": "Easy POS",
  "version": "1.0.0",
  "description": "Simple, fast desktop POS with credit customers, profit reports and automatic backups",
  "main": "main.js",
  "author": "Easy POS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/backend.test.js",
    "dist": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dir --x64 --arm64 && bash scripts/make-dmg.sh"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.easypos.desktop",
    "productName": "Easy POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Easy POS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "EasyPOS-Setup-${version}.exe"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "EasyPOS-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Easy POS ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
