# Hostinger sets PORT automatically - leave it out there
PORT=3000
# --- MySQL / MariaDB ---
# on Hostinger use localhost (or 127.0.0.1 if localhost fails)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ara_pos
# --- Security: set a long random string ---
JWT_SECRET=change-this-to-a-long-random-string
# Public URL of this system (used in WhatsApp/email invoice links)
PUBLIC_URL=http://localhost:3000
TZ=Asia/Colombo
# First admin account (created on first run only - change the password after login)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# Folder for uploads + backups. On Hostinger use a path OUTSIDE the app folder, e.g. /home/u123456789/ara-data
#DATA_DIR=/home/u123456789/ara-data
